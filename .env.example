# Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional. Overrides the primary model (default gemini-3.6-flash; other flash models are rotated in when one hits its quota).
GEMINI_MODEL=
# Optional backups, server-only. Used only when every Gemini model is out of quota or busy.
# Free keys: https://console.groq.com/keys and https://openrouter.ai/settings/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional. Adds live YouTube search results to the Video Finder.
YOUTUBE_API_KEY=

# Optional. Google sign-in. Not read by the app: `supabase config push` reads them from your shell
# (see supabase/config.toml) and stores them in Supabase. Create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials with redirect URI
# https://<project-ref>.supabase.co/auth/v1/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
