# Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional. Overrides the primary model (default gemini-2.5-flash, with automatic fallback).
GEMINI_MODEL=
# Optional. Adds live YouTube search results to the Video Finder.
YOUTUBE_API_KEY=
